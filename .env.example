NODE_ENV=development
SESSION_SECRET=atelier-dev-session-secret
ATELIER_RUNTIME=process
ATELIER_REPO=ticoncreserv/app
# Local listen origin today. In production set the dedicated https domain — not :43123.
ATELIER_PUBLIC_URL=http://127.0.0.1:43123
# Extra local ports that proxy to the studio. Unused behind a public domain.
ATELIER_LOOPBACK_PORTS=80,8080
# Opt in to /setup/github. Off by default so the create-app flow is not public.
ATELIER_ALLOW_GITHUB_APP_SETUP=
# Cursor user API key (Dashboard → API Keys). Required for live prompts.
# The studio strips any inherited Origin-scoped CURSOR_AUTH_TOKEN before spawning agent acp.
CURSOR_API_KEY=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Optional. Leave empty. The studio persists to var/platform.json.
# packages/db is a future Postgres schema only; setting this does not switch the runtime.
DATABASE_URL=
# Optional. Leave empty. Command jobs run in-process (MemoryQueue). Redis is not required.
REDIS_URL=
OTEL_LOG=0
# Comma-separated GitHub logins that always have the /admin panel.
# If empty, GitHub owners bootstrap as admins until one is granted in the panel.
ATELIER_ADMIN_LOGINS=
