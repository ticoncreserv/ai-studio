{
  "name": "atelier",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "predev": "node scripts/ensure-cursor-agent.mjs",
    "start": "bash scripts/up.sh",
    "dev": "pnpm --filter @atelier/web dev",
    "dev:supervisor": "pnpm --filter @atelier/supervisor start",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "i18n:check": "node scripts/ci/check-i18n.mjs",
    "fixture:create": "bash scripts/create-fixture-app.sh",
    "eval": "pnpm --filter @atelier/supervisor eval",
    "typecheck": "pnpm -r --if-present typecheck",
    "bump": "npx npm-check-updates -u --target minor && npm install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
